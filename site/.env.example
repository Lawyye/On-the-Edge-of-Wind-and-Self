# Supabase (server-side only — never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# First admin password for the curator. Used to bootstrap and to recover access.
ADMIN_BOOTSTRAP_PASSWORD=

# Random secrets. Generate with: openssl rand -hex 32
AUTH_SECRET=
IP_HASH_SALT=

# Protects /api/cron/keepalive. Vercel sets this automatically for cron jobs.
CRON_SECRET=
