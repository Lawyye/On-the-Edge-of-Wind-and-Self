# Supabase. When the Vercel project is connected to Supabase through the
# official integration, these two are injected automatically under exactly
# these names — nothing to type by hand.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Everything below is OPTIONAL.

# The admin password normally lives in the database (hashed) and is changed
# from the Settings tab. Set this only as a way back in if it is forgotten.
ADMIN_BOOTSTRAP_PASSWORD=

# Session signing key and the salt used to hash submitter IPs. The app mints
# these once and stores them in the database, so they only need to be set here
# to pin or rotate them deliberately.
AUTH_SECRET=
IP_HASH_SALT=

# Protects /api/cron/keepalive. Vercel sets this automatically for cron jobs.
CRON_SECRET=
